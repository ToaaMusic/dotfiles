#!/usr/bin/env bash
# vim:foldmethod=marker
# vim:foldmarker={{{,}}}
set -euo pipefail

readonly dotfiles_repo_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
readonly dotfiles_config_dir="$dotfiles_repo_dir/config"
readonly dotfiles_home_dir="$dotfiles_repo_dir/home"
readonly dot_config_dir="$HOME/.config"
readonly desktop_entry_dir="$HOME/.local/share/applications"

# opts
run_mode="link"
force_bool=false
select_bool=false

mkdir -p "$dot_config_dir" "$desktop_entry_dir"

# helpers {{{

# get the name of the parent directory
# params:
#   $1 - path
parentname() {
	local path="$1"
	local clean_path="${path%/}" # trim "/"
	local parent_path=$(dirname "$clean_path")
	basename "$parent_path"
}

# list all component paths
# globals:
#   dotfiles_config_dir - dotfiles config directory
#   dotfiles_home_dir   - dotfiles home directory
echo_path_list() {
	for dir in "$dotfiles_config_dir"/*; do
		echo "$dir"
	done
	for file in "$dotfiles_home_dir"/.*; do
		echo "$file"
	done
}

# list configs from this host
# globals:
#   dot_config_dir - $HOME/.config/
echo_target_path_list() {
	for dir in "$dot_config_dir"/*; do
		echo "$dir"
	done
	for file in "$HOME"/.*; do
		echo "$file"
	done
}

# check path type
# params:
#   $1 - path to check
# returns:
#   echo type: "symlink"|"file"|"non-empty directory"|"empty directory"|""
echo_path_type() {
	local path="$1"
	if [[ -L "$path" ]]; then
		echo "symlink"
	elif [[ -f "$path" ]]; then
		echo "file"
	elif [[ -d "$path" ]]; then
		if [[ "$(ls -A "$path" 2>/dev/null)" ]]; then
			echo "non-empty directory"
		else
			echo "empty directory"
		fi
	else
		echo ""
	fi
}

# ask for removing existing path
# params:
#   $1 - path to remove
#   $2 - force remove or not
# returns:
#   0  - removed successfully
#   1  - skipped or failed
ask_rm() {
	local path="$1"
	local force="${2:-false}"
	local path_type="$(echo_path_type "$path")"
	local name="$(basename "$path")"
	if [[ -z "$path_type" ]]; then
		return 0
	fi
	if [[ "$force" == "true" ]] || [[ $path_type == "empty directory" ]]; then
		if rm -rf "$path" 2>/dev/null; then
			echo "✓ Removed $path_type: $name"
			return 0
		else
			return 1
		fi
	fi
	read -rp "$name exists as a $path_type. Override? [y/N] " answer
	case "$answer" in
	[Yy]*)
		if rm -rf "$path" 2>/dev/null; then
			echo "✓ Removed existing $path_type: $name"
			return 0
		else
			echo "✗ Failed to rm $name (permission denied?), skipping" >&2
			return 1
		fi
		;;
	*)
		echo "→ Skipped $name"
		return 1
		;;
	esac
}

# link a single source path to its target
# params:
#   $1 - source path (must be under config/ or home/)
# globals:
#   dot_config_dir - $HOME/.config/
#   force_bool     - global force flag
link_item() {
	local src="$1"
	local name
	name="$(basename "$src")"
	local parent_name
	parent_name="$(parentname "$src")"
	local target
	if [[ "$parent_name" == "config" ]]; then
		target="$dot_config_dir/$name"
	else
		target="$HOME/$name"
	fi
	ask_rm "$target" "$force_bool" || return
	ln -s "$src" "$target"
	echo "Linked $name -> $target"
}

# create toaam-dotfiles.desktop file
# globals:
#   desktop_entry_dir - $HOME/.local/share/applications
create_desktop_entry() {
	mkdir -p "$desktop_entry_dir"

	cat >"$desktop_entry_dir/toaam-dotfiles.desktop" <<'EOF'
[Desktop Entry]
Version=1.0
Type=Application
Name=Zed: Edit Dotfiles
Comment=Open Dotfiles project in Zed
Exec=zsh -lc 'zeditor "$TOAAM_DOTFILES"'
Icon=zed
Terminal=false
Categories=Development;TextEditor;
Keywords=dotfiles;config;zed;
EOF

	chmod +x "$desktop_entry_dir/toaam-dotfiles.desktop"
	echo "Generated desktop entry"
}

# minimal interactive checkbox selector
# params:
#   $@ - items to choose from
# returns:
#   echoes the selected items (one per line) to stdout
# keys:
#   j/k, ↑/↓ - move    space/x - toggle    a/A - select/unselect all
#   enter/o   - confirm  q/esc   - abort (echo nothing)
select_items() {
	local items=("$@")
	local total=${#items[@]}
	[[ $total -eq 0 ]] && return 0

	# read keys from the terminal, not from stdin (stdout is captured)
	local tty_in=/dev/tty
	[[ -r $tty_in ]] || tty_in=/dev/stdin

	local cursor=0 offset=0
	local marked=()

	# draw the whole menu in place
	draw() {
		local height=$((${LINES:-0} - 2))
		[[ $height -lt 1 ]] && height=1
		[[ $cursor -lt $offset ]] && offset=$cursor
		[[ $cursor -ge $((offset + height)) ]] && offset=$((cursor - height + 1))

		local out=""
		local i mark line
		for ((i = offset; i < offset + height && i < total; i++)); do
			mark="[ ]"
			[[ ${marked[i]:-} == 1 ]] && mark="[x]"
			line="  $mark ${items[i]}"
			if [[ $i -eq $cursor ]]; then
				out+=$'\033[7m'"${line}"$'\033[0m'$'\n'
			else
				out+="$line"$'\n'
			fi
		done
		local count=0
		for ((i = 0; i < total; i++)); do
			[[ ${marked[i]:-} == 1 ]] && count=$((count + 1))
		done
		out+="  $((cursor + 1))/$total | $count selected | space:toggle a:all enter:ok q:quit"$'\n'

		# render to the terminal directly so stdout stays clean for the caller
		printf '\033[H\033[2J\033[?25l%b' "$out" >/dev/tty
	}

	printf '\033[?1049h' >/dev/tty # alt screen
	trap 'printf "\033[?25h\033[?1049l" >/dev/tty' EXIT
	draw

	local key k
	while true; do
		IFS= read -rsn1 key <"$tty_in" || { key=""; }
		case "$key" in
		$'\x1b')
			read -rsn2 -t 0.01 k <"$tty_in" || k=""
			case "$k" in
			"[A") key="up" ;;
			"[B") key="down" ;;
			*) key="quit" ;;
			esac
			;;
		"") key="enter" ;;
		" " | x) key="toggle" ;;
		j) key="down" ;;
		k) key="up" ;;
		g) key="home" ;;
		G) key="end" ;;
		a) key="all" ;;
		A) key="none" ;;
		q) key="quit" ;;
		o) key="enter" ;;
		*) key="" ;;
		esac

		case "$key" in
		down) ((cursor < total - 1)) && cursor=$((cursor + 1)) ;;
		up) ((cursor > 0)) && cursor=$((cursor - 1)) ;;
		home) cursor=0 ;;
		end) cursor=$((total - 1)) ;;
		toggle) [[ ${marked[cursor]:-} == 1 ]] && marked[cursor]=0 || marked[cursor]=1 ;;
		all) for ((i = 0; i < total; i++)); do marked[i]=1; done ;;
		none) marked=() ;;
		enter) break ;;
		quit) marked=() && break ;;
		esac
		draw
	done

	printf '\033[?25h\033[?1049l' >/dev/tty
	trap - EXIT

	local i
	for ((i = 0; i < total; i++)); do
		[[ ${marked[i]:-} == 1 ]] && printf '%s\n' "${items[i]}"
	done
}

# }}}

# sub cmd {{{

cmd_clean() {
	for item in $(echo_target_path_list); do
		if [[ -L "$item" ]] && [[ "$(readlink "$item")" == "$dotfiles_repo_dir"* ]]; then
			ask_rm "$item" "$force_bool" || return
			echo "✓ Removed symlink: $item"
		fi
	done
}

# move a target path into the dotfiles repo and link it back
# params:
#   $1 - target path (must be under $HOME/.config/ or $HOME/)
# globals:
#   dotfiles_config_dir - dotfiles config directory
#   dotfiles_home_dir   - dotfiles home directory
add_item() {
	local target="$1"
	local name
	name="$(basename "$target")"
	local parent_name
	parent_name="$(parentname "$target")"
	local dest
	if [[ "$parent_name" == ".config" ]]; then
		dest="$dotfiles_config_dir/$name"
	else
		dest="$dotfiles_home_dir/$name"
	fi
	if [[ -L "$target" ]] && [[ "$(readlink "$target")" == "$dotfiles_repo_dir"* ]]; then
		echo "→ Skipped already managed: $name"
		return
	fi
	if [[ -e "$dest" || -L "$dest" ]]; then
		echo "✗ Already exists in repo: $dest" >&2
		return
	fi
	if mv "$target" "$dest"; then
		ln -s "$dest" "$target"
		echo "✓ Added $name -> $dest"
	else
		echo "✗ Failed to move $name" >&2
	fi
}

cmd_add() {
	while IFS= read -r item; do
		add_item "$item"
	done < <(select_items $(echo_target_path_list))
}

# }}}

# help {{{

# show help menu
show_usage() {
	cat <<'EOF'
Usage: ./link [command] [options]

Dotfiles linker script - creates symbolic links for configuration files.

Commands:
  (no args)      # Default: link all configs, home files, and generate desktop entry
  ls             # List all component paths that would be linked (Ignore all opts)
  clean          # Remove all symlinks managed by this repo
  add            # Add existing configs/home files to this repo (interactive selector)

Options:
  -f, --force    # Force overwrite without confirmation
  -s, --select   # Interactive selector mode (checkbox-style UI)
  -h, --help     # Show this help message 

Examples:
  ./link         # Link without selecting by default
  ./link ls      # Echo all source paths
  ./link ls -h   # each commands allows -h or --help for help

Report issues at: [https://github.com/ToaaMusic/dotfiles]
EOF
}

cmd_ls_help() {
	cat <<'EOF'
Usage: ./link ls

List all component paths that would be linked (Ignore all opts)

Options:
  -h, --help       # Show this help message

Examples:
  ./link ls | fzf  # filter by fzf
EOF
}

cmd_clean_help() {
	cat <<'EOF'
Usage: ./link clean

- Remove all symlinks and files managed by this repo
- Restore the original state (if backed up) - planned

Options:
  -f, --force      # Force remove the link
  -h, --help       # Show this help message

Examples:
  ./link clean -f
EOF
}

cmd_add_help() {
	cat <<'EOF'
Usage: ./link add

- Show an interactive selector of all existing configs and home files
- Move the selected items into this repo (config/ or home/)
- Create a symbolic link back at the original location

Options:
  -h, --help       # Show this help message

Examples:
  ./link add
EOF
}

# }}}

# main {{{

main() {
	temp=$(getopt -o fsh --long force,select,help -n "$0" -- "$@") || {
		show_usage
		exit 1
	}
	eval set -- "$temp"

	while true; do
		case "$1" in
		-f | --force) force_bool=true && shift ;;
		-s | --select) select_bool=true && shift ;;
		-h | --help) run_mode="help" && shift ;;
		--) shift && break ;;
		*) break ;;
		esac
	done

	case "${1:-}" in
	ls) # sub cmds
		if [[ $run_mode == "help" ]]; then
			cmd_ls_help
			exit 0
		fi
		echo_path_list
		;;
	clean)
		if [[ $run_mode == "help" ]]; then
			cmd_clean_help
			exit 0
		fi
		cmd_clean
		;;
	add)
		if [[ $run_mode == "help" ]]; then
			cmd_add_help
			exit 0
		fi
		shift
		cmd_add "$@"
		;;
	"") # main cmd
		if [[ $run_mode == "help" ]]; then
			show_usage
			exit 0
		fi
		if [[ $select_bool == "true" ]]; then
			while IFS= read -r item; do
				link_item "$item"
			done < <(select_items $(echo_path_list))
		else
			for src in $(echo_path_list); do
				link_item "$src"
			done
			create_desktop_entry
		fi
		;;
	*)
		echo "Error: Unknown command '$1'" >&2
		echo "Run './link -h' for usage information." >&2
		exit 1
		;;
	esac
}

# if not source
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
	main "$@"
fi

