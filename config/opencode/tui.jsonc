{
  "$schema": "https://opencode.ai/tui.json",

  // https://opencode.ai/docs/themes/
  "theme": "system",

  // https://opencode.ai/docs/keybinds/
  // "keybinds": {},

  "scroll_speed": 3,
  "scroll_acceleration": {
    "enabled": true,
  },

  "attention": {
    "enabled": true,
    "notifications": true,
    "sound": true,
    "volume": 0.4,
    "sound_pack": "opencode.default",
    "sounds": {
      "error": "./sounds/error.mp3",
    },
  },
}
