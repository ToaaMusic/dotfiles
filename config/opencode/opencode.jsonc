{
  "$schema": "https://opencode.ai/config.json",

  // https://opencode.ai/v2/docs/tools/
  "permissions": [
    { "action": "shell", "resource": "*", "effect": "ask" },
    { "action": "edit", "resource": "*", "effect": "ask" },
  ],

  // https://opencode.ai/v2/docs/agents/
  // "agents": {},

  // https://opencode.ai/v2/docs/models/
  // https://opencode.ai/v2/docs/providers/
  "providers": {
    "anthropic": {
      "settings": {
        "baseURL": "{env:LLM_END_POINT}",
        "apiKey": "{env:ANTHROPIC_API_KEY}",
      },
    },
    "deepseek": {
      "models": {
        "deepseek-v4-pro": {
          "body": {
            "thinking": {
              "type": "disabled",
            },
          },
        },
        "deepseek-v4-flash": {
          "body": {
            "thinking": {
              "type": "disabled",
            },
          },
        },
      },
    },
  },

  // https://opencode.ai/v2/docs/formatters/
  "formatter": false,

  // https://opencode.ai/v2/docs/mcp-servers/
  "mcp": {
    "servers": {
      "avalonia-docs": {
        "type": "remote",
        "url": "https://docs-mcp.avaloniaui.net/mcp",
        "disabled": true,
      },
    },
  },
}
