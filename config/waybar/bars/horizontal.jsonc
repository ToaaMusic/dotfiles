{
  "layer": "bottom",
  "position": "top",
  "name": "horizontal",
  "reload_style_on_change": true,
  "modules-left": ["mpris", "pulseaudio", "pulseaudio/slider"],
  "modules-center": ["clock", "hyprland/workspaces", "group/monitor"],
  "modules-right": [
    // "wlr/taskbar",
    "group/tray",
    "custom/lock",
    "custom/notify",
  ],

  "hyprland/workspaces": {
    "all-outputs": true,
    "sort-by-number": true,
    "show-special": false,
    "format": "{icon}",
    "format-icons": {
      "active": "",
      "default": "",
      "special": "",
    },
  },

  "wlr/taskbar": {
    //"all-outputs": true,
    "format": "{icon}",
    "icon-size": 22,
    "icon-theme": "Numix-Circle",
    "tooltip-format": "{title}",
    "on-click": "minimize-raise",
    "on-click-middle": "close",
  },

  "custom/monitor": {
    "format": "󰣇",
    "tooltip": false,
  },

  "custom/tray-expander": {
    "format": "󰇘",
    "tooltip": false,
  },

  "tray": {
    "show-passive-items": true,
    "expand": true,
    "icon-size": 18,
    "spacing": 3,
  },

  "group/tray": {
    "orientation": "horizontal",
    "drawer": {
      "transition-duration": 500,
      "transition-left-to-right": false,
      "click-to-reveal": false,
    },
    "modules": ["custom/tray-expander", "tray"],
  },

  "custom/lock": {
    "on-click": "hyprlock",
    "format": "󰌾",
    "tooltip": false,
    "menu": "on-click-right",
    "menu-file": "~/.config/waybar/menus/power_menu.xml",
    "menu-actions": {
      "lock": "hyprlock",
      "shutdown": "shutdown",
      "reboot": "reboot",
      "suspend": "systemctl suspend",
      "hibernate": "systemctl hibernate",
    },
  },

  "custom/notify": {
    "exec": "~/.config/waybar/scripts/notify-stat.sh",
    "return-type": "json",
    "signal": 1,
    "interval": 30,
    "on-click": "~/.config/waybar/scripts/notify-toggle.sh",
    "format": "{icon}",
    "format-icons": {
      "activated": "󰂚",
      "deactivated": "󰂛",
    },
    "tooltip": false,
  },

  "group/monitor": {
    "orientation": "horizontal",
    "drawer": {
      "transition-duration": 500,
      "transition-left-to-right": true,
      "click-to-reveal": true,
    },
    "modules": ["custom/monitor", "cpu", "memory", "temperature"],
  },

  "temperature": {
    "interval": 1,
    "hwmon-path": "/sys/class/hwmon/hwmon2/temp1_input",
    "critical-threshold": 80,
    "on-click": "btop",
    "tooltip": true,
    "format": " {temperatureC}°C",
  },

  "memory": {
    "interval": 1,
    "format": "󰍛 {}%",
    "format-alt": "󰍛 {used}/{total} GiB",
    "states": {
      "warning": 85,
    },
  },

  "cpu": {
    "interval": 1,
    "format": "󰻠 {usage}%",
    "format-alt": "󰻠 {avg_frequency} GHz",
  },

  "mpris": {
    //"player": "musicfox",
    "dynamic-order": ["title", "artist"],
    "format": "{player_icon}  {dynamic}",
    "format-paused": "{status_icon}  {dynamic}",
    "status-icons": {
      // , 
      "paused": "",
    },
    "player-icons": {
      "default": "",
    },
    "artist-len": 15,
    "title-len": 20,
  },

  "cava": {
    "cava_config": "$HOME/.config/cava/waybar_raw.conf",
    "input_delay": 2,
    "format-icons": ["▁", "▂", "▃", "▄", "▅", "▆", "▇", "█"],
    "actions": {
      "on-click-right": "mode",
    },
  },

  "pulseaudio": {
    "scroll-step": 1,
    /* "format": "{icon} {volume}%", */
    "format": "{icon}",
    "format-muted": "󰖁",
    "format-icons": {
      "default": ["", "", ""],
    },
    "on-click-right": "pavucontrol",
    "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
    "tooltip": false,
  },

  "pulseaudio/slider": {
    "min": 0,
    "max": 100,
    "orientation": "horizontal",
  },

  "battery": {
    "interval": 10,
    "states": {
      "warning": 20,
      "critical": 10,
    },
    "format": "{icon} {capacity}%",
    "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
    "format-full": "",
    "format-charging": "󰂄 {capacity}%",
    "tooltip": false,
  },

  "clock": {
    "format": " {:%H:%M} ",
    "format-alt": " {:%A, %d %B %Y} ",
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode": "month",
      "mode-mon-col": 3,
      "weeks-pos": "right",
      "on-scroll": 1,
      "format": {
        "months": "<span color='#ffead3'><b>{}</b></span>",
        "days": "<span color='#ecc6d9'><b>{}</b></span>",
        "weeks": "<span color='#99ffdd'><b>W{}</b></span>",
        "weekdays": "<span color='#ffcc66'><b>{}</b></span>",
        "today": "<span color='#ff6699'><b><u>{}</u></b></span>",
      },
    },
    "actions": {
      "on-click-right": "mode",
      "on-scroll-up": "tz_up",
      "on-scroll-down": "tz_down",
      "on-scroll-up": "shift_up",
      "on-scroll-down": "shift_down",
    },
  },
}
