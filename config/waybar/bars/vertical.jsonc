{
  "layer": "bottom",
  "position": "right",
  "reload_style_on_change": true,
  "modules-left": ["hyprland/workspaces"],
  "modules-center": ["clock"],
  "modules-right": ["group/tray", "custom/lock", "custom/notify"],

  "hyprland/workspaces": {
    "all-outputs": true,
    "sort-by-number": true,
    "show-special": false,
    "format": "{icon}",
    "format-icons": {
      "active": "",
      "default": "",
      "special": "",
    },
  },

  "custom/tray-expander": {
    "format": "󰇘",
    "tooltip": false,
  },

  "tray": {
    "show-passive-items": true,
    "expand": true,
    "icon-size": 18,
    "spacing": 3,
  },

  "group/tray": {
    "orientation": "vertical",
    "drawer": {
      "transition-duration": 500,
      "transition-left-to-right": false,
      "click-to-reveal": false,
    },
    "modules": ["custom/tray-expander", "tray"],
  },

  "custom/lock": {
    "on-click": "hyprlock",
    "format": "󰌾",
    "tooltip": false,
    "menu": "on-click-right",
    "menu-file": "~/.config/waybar/menus/power_menu.xml",
    "menu-actions": {
      "lock": "hyprlock",
      "shutdown": "shutdown",
      "reboot": "reboot",
      "suspend": "systemctl suspend",
      "hibernate": "systemctl hibernate",
    },
  },

  "custom/notify": {
    "exec": "~/.config/waybar/scripts/notify-stat.sh",
    "return-type": "json",
    "signal": 1,
    "interval": 30,
    "on-click": "~/.config/waybar/scripts/notify-toggle.sh",
    "format": "{icon}",
    "format-icons": {
      "activated": "󰂚",
      "deactivated": "󰂛",
    },
    "tooltip": false,
  },

  "clock": {
    "format": "{:%H\n%M\n--\n%d\n%m\n%y}",
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode": "month",
      "mode-mon-col": 4,
      "weeks-pos": "right",
      "on-scroll": 1,
      "format": {
        "months": "<span color='#ffead3'><b>{}</b></span>",
        "days": "<span color='#ecc6d9'><b>{}</b></span>",
        "weeks": "<span color='#99ffdd'><b>W{}</b></span>",
        "weekdays": "<span color='#ffcc66'><b>{}</b></span>",
        "today": "<span color='#ff6699'><b><u>{}</u></b></span>",
      },
    },
    "actions": {
      "on-click-right": "mode",
      "on-scroll-up": "tz_up",
      "on-scroll-down": "tz_down",
      "on-scroll-up": "shift_up",
      "on-scroll-down": "shift_down",
    },
  },
}
