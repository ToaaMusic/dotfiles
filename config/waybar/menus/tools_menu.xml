<?xml version="1.0" encoding="UTF-8"?>
<interface>
	<object class="GtkMenu" id="menu">
		<child>
			<object class="GtkMenuItem" id="refresh">
				<child>
					<object class="GtkBox">
						<property name="spacing">6</property>
						<child>
							<object class="GtkImage">
								<property name="icon-name">view-refresh</property>
								<property name="icon-size">1</property>
							</object>
						</child>
						<child>
							<object class="GtkLabel">
								<property name="label">Refresh</property>
							</object>
						</child>
					</object>
				</child>
			</object>
		</child>

		<child>
			<object class="GtkSeparatorMenuItem" id="delimiter1" />
		</child>

		<child>
			<object class="GtkMenuItem" id="select">
				<child>
					<object class="GtkBox">
						<property name="spacing">6</property>
						<child>
							<object class="GtkImage">
								<property name="icon-name">folder-pictures-symbolic</property>
								<property name="icon-size">1</property>
							</object>
						</child>
						<child>
							<object class="GtkLabel">
								<property name="label">Select a wall</property>
							</object>
						</child>
					</object>
				</child>
			</object>
		</child>

		<child>
			<object class="GtkMenuItem" id="random">
				<child>
					<object class="GtkBox">
						<property name="spacing">6</property>
						<child>
							<object class="GtkImage">
								<property name="icon-name">media-playlist-repeat</property>
								<property name="icon-size">1</property>
							</object>
						</child>
						<child>
							<object class="GtkLabel">
								<property name="label">Random wall</property>
							</object>
						</child>
					</object>
				</child>
			</object>
		</child>

		<child>
			<object class="GtkMenuItem" id="web">
				<child>
					<object class="GtkBox">
						<property name="spacing">6</property>
						<child>
							<object class="GtkImage">
								<property name="icon-name">folder-remote-symbolic</property>
								<property name="icon-size">1</property>
							</object>
						</child>
						<child>
							<object class="GtkLabel">
								<property name="label">Random wall from web</property>
							</object>
						</child>
					</object>
				</child>
			</object>
		</child>
	</object>
</interface>
